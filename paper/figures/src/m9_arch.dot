digraph m9 {
  graph [rankdir=TB, fontname="Helvetica", fontsize=10, nodesep=0.3, ranksep=0.3];
  node  [shape=box, style="rounded,filled", fillcolor="#f4f6fa", color="#4a5a78", fontname="Helvetica", fontsize=9];
  edge  [color="#4a5a78", arrowsize=0.6, fontname="Helvetica", fontsize=8];

  inp  [label="Per EFIT frame t (inputs only)\n14 currents: EFPS, SOL, TF, P2-P6 U/L, Ip\n131 core Te + 131 core ne (time-interpolated)\n32 edge Thomson (zeroed)", fillcolor="#fff3d6"];
  x    [label="x_t in R^308"];
  aug  [label="per-shot temporal augmentation (window 9)\n[ x_t | moving average a_t | (a_{t+4} - a_{t-4}) / 8 ]\nR^924, standardise, clip +-10"];
  subgraph cluster_net { label="CoeffDualContext  (one member f_s)"; style="rounded"; color="#888888";
    pst  [label="present stem\nLinear 308 -> 512, ReLU"];
    pb   [label="4 x residual block (512)\ndropout 0.05"];
    cst  [label="context stem\nLinear 616 -> 512, ReLU"];
    cb   [label="3 x residual block (512)"];
    proj [label="Linear 512 -> 512 (P)"];
    gate [label="h + g * P c\ngate g (init 0)", shape=ellipse];
    head [label="linear head 512 -> 60\nPCA coefficients z"];
  }
  rec  [label="psi = mu + C^T z\n(PCA mean + 60 EFIT++ modes)\n65 x 65 grid"];
  ens  [label="ensemble mean over seeds\n{101, 202, 303}", fillcolor="#e8f3ea"];
  out  [label="psi_M9(R, Z)", shape=ellipse, fillcolor="#fde9e7"];
  loss [label="training loss: MSE(z, z_EFIT)\nno physics residual", shape=note, fillcolor="#ffffff"];

  inp -> x -> aug;
  aug -> pst [label="x[:308]"]; pst -> pb -> gate;
  aug -> cst [label="x[308:]"]; cst -> cb -> proj -> gate;
  gate -> head -> rec -> ens -> out;
  head -> loss [style=dotted, arrowhead=none];
}
