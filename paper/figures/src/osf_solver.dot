digraph osf {
  graph [rankdir=TB, fontname="Helvetica", fontsize=10, nodesep=0.3, ranksep=0.3];
  node  [shape=box, style="rounded,filled", fillcolor="#f4f6fa", color="#4a5a78", fontname="Helvetica", fontsize=9];
  edge  [color="#4a5a78", arrowsize=0.6, fontname="Helvetica", fontsize=8];

  meas  [label="measured at EFIT time t:\ncoil currents I_c, Ip, I_TF, Thomson Te, ne", fillcolor="#fff3d6"];
  clk   [label="clocks\nw = (1 - min(I_P2 / (|Ip| r*), 1))^2\nb = clip(I_sol / I*, 0, 1)"];
  vac   [label="vacuum flux\npsi_vac = sum_c lambda_c(b) I_c Psi_c\nGreen's function, 812 rectangles x 9 filaments"];
  ell   [label="current support: ellipse\nR0, Z0, a_R, a_Z (w, b)"];
  beta0 [label="first-guess betaN -> <p>"];
  subgraph cluster_pic { label="Picard iteration (<= 20 passes)"; style="rounded"; color="#888888";
    j    [label="j = R p'(tau) + FF'(tau) / (mu0 R)\np' ~ <p>(1 - tau) / (dpsi s_V), FF' = -gamma (1 - tau)\nrescale: int j dA = k(w, b) Ip"];
    psi  [label="psi = psi_vac + G j"];
    ox   [label="O-point, X-points, LCFS\ndpsi = psi_axis - psi_b, W, s_V"];
    conv [label="max|d psi| < 1e-4 and\nrel. change < 1e-3 ?", shape=diamond];
  }
  q95   [label="q_map = |F_b| W / 2 pi (vacuum F_b)\nwell / walk / hole factor law -> q95"];
  bn    [label="betaN = 100 <p> 2 mu0 a / (B_t Ip)\n<p> from Thomson inside LCFS\nclip, 7-frame median, x (1 - 0.2 w)"];
  out   [label="psi_OSF(R, Z), q95, betaN", shape=ellipse, fillcolor="#fde9e7"];

  meas -> clk; meas -> vac; clk -> vac; clk -> ell; meas -> beta0;
  ell -> j; beta0 -> j; vac -> psi; j -> psi -> ox -> conv;
  conv -> j [label="no"]; conv -> q95 [label="yes"]; conv -> bn [label="yes"];
  meas -> bn [style=dashed]; q95 -> out; bn -> out; ox -> out [style=dashed];
}
